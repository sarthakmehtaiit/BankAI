# Copy this file to .env and fill in the values.

# PostgreSQL connection string (local Postgres, Supabase or Neon all work)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bankai
# Set to true for hosted databases like Supabase, Neon or Render
DATABASE_SSL=false

# Long random strings. Never commit real values.
JWT_SECRET=change-me-to-a-long-random-string
PAN_HASH_SECRET=change-me-to-another-long-random-string

# Free key from https://aistudio.google.com/apikey
# The app still works without it: AI features switch to safe fallbacks.
GEMINI_API_KEY=
# Main model, and a lighter backup used when the main one is busy or slow.
# Old models get retired for new accounts; any "flash" model your key can use works.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# minimal | low | medium | high. Less thinking = faster. Leave empty for Gemini 2.x models.
GEMINI_THINKING=minimal

# Only for `npm test`. Use a SEPARATE empty database: the tests delete its data.
TEST_DATABASE_URL=
